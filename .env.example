APP_ENV=production
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/standard
GA_MEASUREMENT_ID=
# Absolute path outside the website document root, required in production.
APP_DATA_DIR=
# Absolute path to uploaded site files; used by CLI backup/restore/check commands.
